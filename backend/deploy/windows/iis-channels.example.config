<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 리버스 프록시 예시. 채널을 서비스하는 사이트의 루트에 web.config로 두면 된다.
  경로 접두어를 떼고 루프백 포트로 넘기므로, 앱에 넣을 채널 URL은 https://<도메인>/shop 가 된다.

  http와 https를 모두 받는다. 사이트 바인딩을 80과 443 둘 다 추가하면 두 주소가 그대로 동작하고,
  앱에는 어느 쪽을 등록해도 된다. 리다이렉트를 걸지 않는 이유는 아래 https 항목에 적어뒀다.

  먼저 서버 수준에서 한 번 해둘 것 (관리자 권한):
    1) IIS에 URL Rewrite와 Application Request Routing(ARR) 설치
    2) ARR 프록시 켜기 + 타임아웃 늘리기
       %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy ^
         /enabled:"True" /timeout:"00:02:00" /commit:apphost
       (기본 30초로는 업스트림이 느릴 때 504가 난다)
    3) 방화벽은 쓰는 포트(80/443)만 열고, 채널 포트(12001...)는 열지 않는다.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          채널 하나당 규칙 하나. 포트는 각 채널의 .env와 맞춘다.
          http로 들어와도 같은 규칙을 타므로 따로 손댈 것이 없다.
        -->
        <rule name="channel-shop" stopProcessing="true">
          <match url="^shop/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:12001/{R:1}" />
        </rule>

        <!--
          채널이 늘면 이렇게 한 줄씩 추가한다. 기존 채널은 건드리지 않아도 된다.
          shop처럼 이미지를 서비스하는 채널은 .env의 PUBLIC_BASE_URL을 공개 주소
          (예: https://<도메인>/shop)로 맞춰야 앱이 카드 사진을 받아갈 수 있다.
        <rule name="channel-hr" stopProcessing="true">
          <match url="^hr/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:12005/{R:1}" />
        </rule>
        -->

        <!--
          https만 쓰기로 정했다면 이 규칙을 위 규칙들보다 앞에 두면 된다.
          단 앱에는 반드시 https URL로 등록해야 한다. POST가 리다이렉트를 타면
          본문이 사라져 툴 호출이 조용히 실패한다.
        <rule name="https-only" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!--
          HSTS는 넣지 않았다. 한 번 받으면 브라우저가 그 도메인의 http를 막아버려서
          http로도 쓰려는 구성과 충돌한다. https만 쓸 때 추가하면 된다.
          <add name="Strict-Transport-Security" value="max-age=31536000" />
        -->
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!--
      채널 응답은 JSON과 (shop의) 제품 사진뿐이라 정적 파일 처리나 디렉터리 목록은 필요 없다.
      사진도 채널이 직접 내려주므로 IIS에 파일을 둘 일은 없다.
    -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
