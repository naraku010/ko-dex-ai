# 앱이 채널을 추가할 때 넣는 API 키. 쉼표로 여러 개.
# 비워두면 인증 없이 열리니 배포 서버에서는 반드시 채운다.
CHANNEL_API_KEYS=change-me

# 이 채널 서버가 뜰 주소. 배포 스크립트가 이 값으로 서비스를 등록한다.
# 127.0.0.1 이면 이 서버 안에서만 붙고, 외부 노출은 앞단 프록시가 맡는다.
# 프록시 없이 다른 PC에서 바로 붙게 하려면 0.0.0.0 으로 두고 방화벽에서 PORT를 열어준다.
# PORT는 채널마다 다르게 준다.
HOST=127.0.0.1
PORT=12001

# 앱이 상품 카드 이미지를 받아갈 주소. 앱에 등록한 채널 주소와 같아야 한다.
# 예) 직접 노출 http://192.168.0.10:12001 / 프록시 뒤 http://channels.사내도메인/shop
PUBLIC_BASE_URL=http://127.0.0.1:12001

# 데모 DB 위치. 비우면 channels/shop/data/demo.db 를 쓰고, 없으면 시작할 때 만든다.
# SHOP_DB_PATH=channels/shop/data/demo.db
